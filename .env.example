# Alibaba Cloud — DashScope (Model Studio), dùng cho tầng [2] tầng cloud.
# Copy file này thành .env rồi dán key vào. .env đã được gitignore.

# Key lấy ở Model Studio console. KHÔNG commit.
# Nhận cả các tên khác: ALIBABA_API_KEY, ALIBABA_CLOUD_API_KEY, QWEN_API_KEY.
DASHSCOPE_API_KEY=

# Endpoint OpenAI-compatible.
#   Quốc tế (Singapore): https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   Trung Quốc (Bắc Kinh): https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTCAR_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# qwen-max (chính xác nhất) | qwen-plus (cân bằng) | qwen-turbo (nhanh, rẻ)
AGENTCAR_LLM_MODEL=qwen-plus

# Quá hạn thì bỏ, trả câu fallback. Bỏ trống = lấy theo gate.deadline_ms trong caps.
# 1200ms của caps là ngưỡng cho TẦNG EDGE ở edge. Tầng suy luận trên cloud cần rộng
# hơn: prompt có kèm ngữ cảnh nên p50 ~910ms, thỉnh thoảng vọt 1400ms.
# Để trống = lấy theo gate.deadline_ms trong caps (1200ms):
# giữ kết nối TLS giữa các lượt cho p50=747ms p90=785ms max=838ms (đo 10 câu,
# VN -> Singapore, qwen-plus). Trước khi giữ kết nối thì p50=1170ms max=2066ms,
# rớt 3/10 câu ở mốc 1200ms.
AGENTCAR_LLM_TIMEOUT_MS=1800

# Bật/tắt tầng [2]. Để false thì câu không khớp vẫn trả ESCALATE_UNKNOWN như hiện nay.
AGENTCAR_LLM_ENABLED=false
